---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Main from "@layouts/Main.astro";
import Infographic from "@components/Infographic.astro";
import { infographicExample } from "@data/infographicExample";
import { SITE } from "@config";
import type { Locale } from "@i18n/config";

export interface Props {
  lang?: Locale;
}
const { lang = "en" } = Astro.props;
const zh = lang === "zh-hant";
const title = zh ? "資訊圖表" : "Infographics";
const description = zh
  ? "以 Min Infograph 呈現結構化內容與圖表。"
  : "Structured content and diagrams rendered with Min Infograph.";
const alternates = {
  en: new URL("/toolbox/infographics/", Astro.site).href,
  "zh-hant": new URL("/zh-hant/toolbox/infographics/", Astro.site).href,
};
---

<Layout title={`${title} | ${SITE.title}`} {description} {lang} {alternates}>
  <Header activeNav="toolbox" {lang} />
  <Main pageTitle={title} pageDesc={description}>
    <p class="mb-6">
      <a href={zh ? "/zh-hant/toolbox/" : "/toolbox/"} class="underline">
        {zh ? "返回工具箱" : "Back to Toolbox"}
      </a>
      ·
      <a
        href="https://www.npmjs.com/package/@min-infograph/core"
        class="underline">Min Infograph</a
      >
    </p>
    <Infographic
      document={infographicExample(lang)}
      sourceLabel={zh ? "圖表原始碼" : "Diagram source"}
    />
  </Main>
  <Footer />
</Layout>
