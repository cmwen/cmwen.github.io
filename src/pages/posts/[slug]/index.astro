---
import { type CollectionEntry, getCollection } from "astro:content";
import Posts from "@layouts/Posts.astro";
import PostDetails from "@layouts/PostDetails.astro";
import getSortedPosts from "@utils/getSortedPosts";
import getPageNumbers from "@utils/getPageNumbers";
import getPagination from "@utils/getPagination";
import { getPostSlug } from "@utils/contentEntry";
import type { Locale } from "@i18n/config";

export interface Props {
  post: CollectionEntry<"blog">;
  alternateLanguages: Locale[];
}

export async function getStaticPaths() {
  const all = await getCollection("blog");
  const posts = all.filter(p => !p.data.draft && p.data.lang === "en");
  const published = all.filter(post => !post.data.draft);

  const postResult = posts.map(post => ({
    params: { slug: getPostSlug(post) },
    props: {
      post,
      alternateLanguages: published
        .filter(candidate => getPostSlug(candidate) === getPostSlug(post))
        .map(candidate => candidate.data.lang),
    },
  }));

  const pagePaths = getPageNumbers(posts.length).map(pageNum => ({
    params: { slug: String(pageNum) },
  }));

  return [...postResult, ...pagePaths];
}

const { slug } = Astro.params;
const { post, alternateLanguages } = Astro.props;

const posts = await getCollection("blog", ({ data }) => data.lang === "en");

const sortedPosts = getSortedPosts(posts);

const pagination = getPagination({
  posts: sortedPosts,
  page: slug,
});
---

{
  post ? (
    <PostDetails {post} {alternateLanguages} />
  ) : (
    <Posts {...pagination} lang="en" />
  )
}
